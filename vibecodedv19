table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    -- FOV Logic
    if Config.Aimbot.Enabled and Config.Aimbot.FOVEnabled then
        local mouseLoc = UserInputService:GetMouseLocation()
        FOVCircle.Size = UDim2.new(0, Config.Aimbot.FOVRadius * 2, 0, Config.Aimbot.FOVRadius * 2)
        FOVCircle.Position = UDim2.new(0, mouseLoc.X - Config.Aimbot.FOVRadius, 0, mouseLoc.Y - Config.Aimbot.FOVRadius)
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    -- Aimbot Logic
    local orbitingThisFrame = false
    if Config.Aimbot.Enabled and Config.Aimbot.IsLocking and Config.Aimbot.CurrentTarget then
        local target = Config.Aimbot.CurrentTarget
        if target.Character and target.Character:FindFirstChild(Config.Aimbot.TargetPart) then
            local humanoid = target.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local targetPart = target.Character[Config.Aimbot.TargetPart]
                local targetPos = targetPart.Position
                if Config.Aimbot.Prediction > 0 then
                    targetPos = targetPos + (targetPart.AssemblyLinearVelocity * Config.Aimbot.Prediction)
                end
                local lerpAlpha = 10 ^ -(Config.Aimbot.Smoothness * 3)
                if Config.Aimbot.Smoothness <= 0.01 then lerpAlpha = 1 end
                lerpAlpha = math.clamp(lerpAlpha, 0.001, 1)

                -- Orbit
                if Config.Aimbot.OrbitEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    orbitingThisFrame = true
                    local myHrp = LocalPlayer.Character.HumanoidRootPart
                    currentOrbitAngle = currentOrbitAngle + math.rad(Config.Aimbot.OrbitSpeed) * dt * 30
                    local x = math.cos(currentOrbitAngle) * Config.Aimbot.OrbitRadius
                    local z = math.sin(currentOrbitAngle) * Config.Aimbot.OrbitRadius
                    local hrpCenter = target.Character.HumanoidRootPart.Position
                    local desiredPos = hrpCenter + Vector3.new(x, Config.Aimbot.OrbitHeight, z)
                    myHrp.CFrame = CFrame.new(desiredPos, hrpCenter)
                    OrbitVisual.Size = Vector3.new(0.2, Config.Aimbot.OrbitRadius * 2, Config.Aimbot.OrbitRadius * 2)
                    OrbitVisual.CFrame = CFrame.new(hrpCenter) * CFrame.Angles(0, 0, math.rad(90))
                end

                if Config.Aimbot.Method == "Camlock" then
                    local currentCFrame = Camera.CFrame
                    Camera.CFrame = currentCFrame:Lerp(CFrame.new(currentCFrame.Position, targetPos), lerpAlpha)
                elseif Config.Aimbot.Method == "Mouselock" then
                    local targetScreenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                    if onScreen then
                        local mousePos = UserInputService:GetMouseLocation()
                        local moveX = (targetScreenPos.X - mousePos.X) * lerpAlpha
                        local moveY = (targetScreenPos.Y - mousePos.Y) * lerpAlpha
                        if mousemoverel then mousemoverel(moveX, moveY) end
                    end
                end

                -- Snaplines
                if Config.Aimbot.Snaplines then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local mouseLoc = UserInputService:GetMouseLocation()
                        local endPos = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (mouseLoc - endPos).Magnitude
                        local center = (mouseLoc + endPos) / 2
                        SnaplineFrame.BackgroundColor3 = Config.Aimbot.SnaplinesColor
                        SnaplineFrame.Size = UDim2.new(0, dist, 0, 1)
                        SnaplineFrame.Position = UDim2.new(0, center.X, 0, center.Y)
                        SnaplineFrame.Rotation = math.deg(math.atan2(endPos.Y - mouseLoc.Y, endPos.X - mouseLoc.X))
                        SnaplineFrame.Visible = true
                    else SnaplineFrame.Visible = false end
                else SnaplineFrame.Visible = false end
            else
                local next = GetClosestPlayerToMouse()
                if next then Config.Aimbot.CurrentTarget = next ShowToast(next.Name)
                else Config.Aimbot.CurrentTarget = nil HideToast() end
                SnaplineFrame.Visible = false
            end
        else
            local next = GetClosestPlayerToMouse()
            if next then Config.Aimbot.CurrentTarget = next ShowToast(next.Name)
            else Config.Aimbot.CurrentTarget = nil HideToast() end
            SnaplineFrame.Visible = false
        end
    else SnaplineFrame.Visible = false end

    if not orbitingThisFrame then OrbitVisual.CFrame = CFrame.new(0, -9999, 0) end

    -- Triggerbot
    local triggerbotActive = Config.Aimbot.Triggerbot
    if triggerbotActive then
        -- Keybind gate: Unknown = no key required; otherwise check hold/toggle state
        if Config.Aimbot.TriggerbotKeybind ~= Enum.KeyCode.Unknown then
            if Config.Aimbot.TriggerbotMode == "Hold" then
                triggerbotActive = UserInputService:IsKeyDown(Config.Aimbot.TriggerbotKeybind)
            else
                triggerbotActive = Config.Aimbot.TriggerbotKeyActive
            end
        end
    end
    if triggerbotActive then
        local target = Mouse.Target
        if target and target.Parent then
            local hitPlayer = Players:GetPlayerFromCharacter(target.Parent)
            if hitPlayer and hitPlayer ~= LocalPlayer then
                if not (Config.Aimbot.TeamCheck and IsTeammate(hitPlayer)) then
                    local now = os.clock() * 1000
                    if not _G._tbLastClick then _G._tbLastClick = 0 end
                    if (now - _G._tbLastClick) >= Config.Aimbot.TriggerbotDelay then
                        _G._tbLastClick = now
                        if mouse1press then mouse1press() end
                        task.delay(0.016, function() if mouse1release then mouse1release() end end)
                    end
                end
            end
        end
    end

    if ClickTPHeld and Mouse.Hit then
        ClickTPVisual.CFrame = CFrame.new(Mouse.Hit.Position) * CFrame.Angles(0, 0, math.rad(90))
    else ClickTPVisual.CFrame = CFrame.new(0, -9999, 0) end

    -- ESP Logic
