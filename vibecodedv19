                local boxInfo = Config.ESP.Boxes[player]
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    local hrp = char.HumanoidRootPart
                    local cframe, size = char:GetBoundingBox()
                    local topPos = cframe.Position + Vector3.new(0, size.Y / 2, 0)
                    local bottomPos = cframe.Position - Vector3.new(0, size.Y / 2, 0)
                    local hrpScreen = Camera:WorldToViewportPoint(cframe.Position)
                    local topScreen = Camera:WorldToViewportPoint(topPos)
                    local bottomScreen = Camera:WorldToViewportPoint(bottomPos)

                    if hrpScreen.Z > 0 then
                        local height = math.abs(topScreen.Y - bottomScreen.Y)
                        local width = height / 1.5

                        if Config.ESP.Enabled then
                            boxInfo.Box.Size = UDim2.new(0, width, 0, height)
                            boxInfo.Box.Position = UDim2.new(0, hrpScreen.X - (width / 2), 0, math.min(topScreen.Y, bottomScreen.Y))
                            boxInfo.Box.Visible = true
                        else boxInfo.Box.Visible = false end

                        if Config.ESP.Names then
                            boxInfo.NameLabel.Position = UDim2.new(0, hrpScreen.X - 100, 0, math.min(topScreen.Y, bottomScreen.Y) - 22)
                            boxInfo.NameLabel.Visible = true
                        else boxInfo.NameLabel.Visible = false end

                        if Config.ESP.Distance then
                            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local distanceStr = ""
                            if myHrp and hrp then distanceStr = tostring(math.floor((myHrp.Position - hrp.Position).Magnitude)) .. " studs" end
                            boxInfo.DistanceLabel.Text = distanceStr
                            boxInfo.DistanceLabel.Position = UDim2.new(0, hrpScreen.X - 100, 0, math.max(topScreen.Y, bottomScreen.Y) + 2)
                            boxInfo.DistanceLabel.Visible = true
                        else boxInfo.DistanceLabel.Visible = false end

                        if Config.ESP.Tracers then
                            local tracerLine = boxInfo.TracerLine
                            if not tracerLine then
                                tracerLine = Instance.new("Frame")
                                tracerLine.AnchorPoint = Vector2.new(0.5, 0.5)
                                tracerLine.BackgroundColor3 = Config.ESP.TracerColor
                                tracerLine.BorderSizePixel = 0
                                tracerLine.ZIndex = 2
                                tracerLine.Parent = boxInfo.Gui
                                boxInfo.TracerLine = tracerLine
                            end
                            local viewportSize = Camera.ViewportSize
                            local startPos
                            if Config.ESP.TracerOrigin == "Top" then startPos = Vector2.new(viewportSize.X / 2, 0)
                            elseif Config.ESP.TracerOrigin == "Mouse" then startPos = UserInputService:GetMouseLocation()
                            else startPos = Vector2.new(viewportSize.X / 2, viewportSize.Y) end
                            local endPos = Vector2.new(hrpScreen.X, hrpScreen.Y)
                            local distance = (startPos - endPos).Magnitude
                            local center = (startPos + endPos) / 2
                            tracerLine.Size = UDim2.new(0, distance, 0, 1)
                            tracerLine.Position = UDim2.new(0, center.X, 0, center.Y)
                            tracerLine.Rotation = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X))
                            tracerLine.Visible = true
                        else if boxInfo.TracerLine then boxInfo.TracerLine.Visible = false end end

                        if Config.ESP.HealthBar then
                            local actualHP = math.clamp(char.Humanoid.Health / char.Humanoid.MaxHealth, 0, 1)
                            boxInfo.VisualHealth = boxInfo.VisualHealth or actualHP
                            boxInfo.VisualHealth = boxInfo.VisualHealth + (actualHP - boxInfo.VisualHealth) * math.min((dt or 1/60) * 10, 1)
                            local color
                            if boxInfo.VisualHealth >= 0.7 then color = Color3.fromRGB(30, 215, 96)
                            elseif boxInfo.VisualHealth >= 0.4 then color = Color3.fromRGB(241, 196, 15)
                            else color = Color3.fromRGB(231, 76, 60) end
                            boxInfo.HealthBg.Size = UDim2.new(0, 2, 0, height)
                            boxInfo.HealthBg.Position = UDim2.new(0, hrpScreen.X - (width / 2) - 8, 0, math.min(topScreen.Y, bottomScreen.Y))
                            boxInfo.HealthBg.Visible = true
                            boxInfo.HealthFill.Size = UDim2.new(1, 0, boxInfo.VisualHealth, 0)
                            boxInfo.HealthFill.Position = UDim2.new(0, 0, 1 - boxInfo.VisualHealth, 0)
                            boxInfo.HealthFill.BackgroundColor3 = color
                        else if boxInfo.HealthBg then boxInfo.HealthBg.Visible = false end end

                        if Config.ESP.Skeleton then
                            if not boxInfo.SkeletonLines then boxInfo.SkeletonLines = {} end
                            local lineIndex = 1
                            for _, connection in ipairs(skeletonConnections) do
                                local part1 = char:FindFirstChild(connection[1])
                                local part2 = char:FindFirstChild(connection[2])
                                if part1 and part2 then
                                    local p1Pos, p1On = Camera:WorldToViewportPoint(part1.Position)
                                    local p2Pos, p2On = Camera:WorldToViewportPoint(part2.Position)
                                    if p1On or p2On then
                                        local line = boxInfo.SkeletonLines[lineIndex]
                                        if not line then
                                            line = Instance.new("Frame")
                                            line.AnchorPoint = Vector2.new(0.5, 0.5)
                                            line.BackgroundColor3 = Config.ESP.SkeletonColor
                                            line.BorderSizePixel = 0
                                            line.ZIndex = 2
                                            line.Parent = boxInfo.Gui
                                            boxInfo.SkeletonLines[lineIndex] = line
                                        end
                                        local d = (Vector2.new(p1Pos.X, p1Pos.Y) - Vector2.new(p2Pos.X, p2Pos.Y)).Magnitude
                                        local c = (Vector2.new(p1Pos.X, p1Pos.Y) + Vector2.new(p2Pos.X, p2Pos.Y)) / 2
                                        line.Size = UDim2.new(0, d, 0, Config.ESP.Thickness)
                                        line.Position = UDim2.new(0, c.X, 0, c.Y)
                                        line.Rotation = math.deg(math.atan2(p2Pos.Y - p1Pos.Y, p2Pos.X - p1Pos.X))
                                        line.Visible = true
                                        lineIndex = lineIndex + 1
                                    end
                                end
                            end
                            for i = lineIndex, #boxInfo.SkeletonLines do
                                if boxInfo.SkeletonLines[i] then boxInfo.SkeletonLines[i].Visible = false end
                            end
                        else
                            if boxInfo.SkeletonLines then for _, line in ipairs(boxInfo.SkeletonLines) do line.Visible = false end end
                        end
                    else
                        boxInfo.Box.Visible = false
                        if boxInfo.NameLabel then boxInfo.NameLabel.Visible = false end
                        if boxInfo.DistanceLabel then boxInfo.DistanceLabel.Visible = false end
                        if boxInfo.TracerLine then boxInfo.TracerLine.Visible = false end
                        if boxInfo.HealthBg then boxInfo.HealthBg.Visible = false end
                        if boxInfo.SkeletonLines then for _, line in ipairs(boxInfo.SkeletonLines) do line.Visible = false end end
                    end
                else
                    boxInfo.Box.Visible = false
                    if boxInfo.NameLabel then boxInfo.NameLabel.Visible = false end
                    if boxInfo.DistanceLabel then boxInfo.DistanceLabel.Visible = false end
                    if boxInfo.TracerLine then boxInfo.TracerLine.Visible = false end
                    if boxInfo.HealthBg then boxInfo.HealthBg.Visible = false end
                    if boxInfo.SkeletonLines then for _, line in ipairs(boxInfo.SkeletonLines) do line.Visible = false end end
                end
            end
        end
    end

    -- Movement Logic
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local hum = LocalPlayer.Character.Humanoid

        if orbitingThisFrame then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        if Config.Misc.SpinEnabled and not orbitingThisFrame then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.Misc.SpinSpeed) * dt, 0)
        end

        if Config.Misc.DesyncEnabled and Config.Misc.DesyncCFrame then
            local camCF = Camera.CFrame
            local moveDir = Vector3.new(0, 0, 0)
            local speed = 16
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit end
            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
            local newPos = Config.Misc.DesyncCFrame.Position + (moveDir * speed * (1/60))
            Config.Misc.DesyncCFrame = CFrame.new(newPos, newPos + Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z))
            hrp.CFrame = Config.Misc.DesyncCFrame
            return
        end

        if Config.Movement.FlyEnabled then
            local camCFrame = Camera.CFrame
            local moveVector = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveVector = moveVector - Vector3.new(0, 1, 0) end
            if moveVector.Magnitude > 0 then moveVector = moveVector.Unit end
            hrp.AssemblyLinearVelocity = moveVector * Config.Movement.FlySpeed
            hrp.CFrame = CFrame.new(hrp.Position) * (camCFrame - camCFrame.Position)
            local attachment = hrp:FindFirstChild("FlyAttachment")
            if not attachment then attachment = Instance.new("Attachment") attachment.Name = "FlyAttachment" attachment.Parent = hrp end
            local vectorForce = hrp:FindFirstChild("FlyForce")
            if not vectorForce then vectorForce = Instance.new("VectorForce") vectorForce.Name = "FlyForce" vectorForce.Attachment0 = attachment vectorForce.Parent = hrp end
            vectorForce.Force = Vector3.new(0, workspace.Gravity * hrp.AssemblyMass, 0)
            hum.PlatformStand = true
        else
            local attachment = hrp:FindFirstChild("FlyAttachment")
            local vectorForce = hrp:FindFirstChild("FlyForce")
            if attachment then attachment:Destroy() end
            if vectorForce then vectorForce:Destroy() end
            if hum.PlatformStand then hum.PlatformStand = false end
            if Config.Movement.SpeedEnabled then
                if hum.MoveDirection.Magnitude > 0 then
                    local currentY = hrp.AssemblyLinearVelocity.Y
                    hrp.AssemblyLinearVelocity = (hum.MoveDirection * Config.Movement.SpeedValue) + Vector3.new(0, currentY, 0)
                end
            end
            if Config.Movement.JumpEnabled then
                hum.UseJumpPower = true
                hum.JumpPower = Config.Movement.JumpValue
                Config.Movement.WasJumpEnabled = true
            else
                if Config.Movement.WasJumpEnabled then hum.JumpPower = 50 Config.Movement.WasJumpEnabled = false end
            end
        end
    end
end))

-- Noclip Logic
table.insert(Connections, RunService.Stepped:Connect(function()
    if Config.Movement.NoclipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        Config.Movement.WasNoclipEnabled = true
    elseif Config.Movement.WasNoclipEnabled and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        local lowerTorso = char:FindFirstChild("LowerTorso")
        if hrp then hrp.CanCollide = true end
        if head then head.CanCollide = true end
        if torso then torso.CanCollide = true end
        if lowerTorso then lowerTorso.CanCollide = true end
        Config.Movement.WasNoclipEnabled = false
    end
end))

-- Clean up ESP when a player leaves
table.insert(Connections, Players.PlayerRemoving:Connect(function(player)
    if Config.ESP.Boxes[player] then
        Config.ESP.Boxes[player].Gui:Destroy()
        Config.ESP.Boxes[player] = nil
    end
end))

