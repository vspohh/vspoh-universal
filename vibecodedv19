-- ═══════════════════════════════════════════
-- Unload
-- ═══════════════════════════════════════════
local function UnloadScript()
    for _, conn in ipairs(Connections) do
        if conn then conn:Disconnect() end
    end
    if ScreenGui then ScreenGui:Destroy() end
    if BlurEffect then BlurEffect:Destroy() end
    if ActiveColorPicker then ActiveColorPicker:Destroy() end
    if Config.ESP and Config.ESP.Boxes then
        for _, boxInfo in pairs(Config.ESP.Boxes) do
            if boxInfo.Gui then boxInfo.Gui:Destroy() end
        end
        Config.ESP.Boxes = {}
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local hum = LocalPlayer.Character.Humanoid
        local attachment = hrp:FindFirstChild("FlyAttachment")
        local vectorForce = hrp:FindFirstChild("FlyForce")
        if attachment then attachment:Destroy() end
        if vectorForce then vectorForce:Destroy() end
        hum.PlatformStand = false
    end
    print("Aimbot & ESP Unloaded.")
end

