local function CreateTab(name, index, isActive)
    local TabBtn = Instance.new("TextButton")
    TabBtn.BackgroundTransparency = 1
    TabBtn.TextColor3 = isActive and COLORS.tabActive or COLORS.tabInactive
    TabBtn.Text = name
    TabBtn.Font = isActive and Enum.Font.GothamBold or Enum.Font.Gotham
    TabBtn.TextSize = 13
    TabBtn.BorderSizePixel = 0
    TabBtn.AutoButtonColor = false
    TabBtn.Parent = TabContainer

    local Content = Instance.new("ScrollingFrame")
    Content.Size = UDim2.new(1, 0, 1, 0)
    Content.BackgroundTransparency = 1
    Content.Visible = isActive
    Content.ScrollBarThickness = 3
    Content.ScrollBarImageColor3 = COLORS.accent
    Content.BorderSizePixel = 0
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Content.Parent = ContentContainer

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 6)
    Layout.Parent = Content

    local Pad = Instance.new("UIPadding")
    Pad.PaddingRight = UDim.new(0, 4)
    Pad.Parent = Content

    table.insert(tabButtons, {Button = TabBtn, Index = index, Name = name})
    tabContents[name] = Content

    return TabBtn, Content
end

