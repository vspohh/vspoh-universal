local function AdjustTabSizes()
    local numTabs = #tabButtons
    if numTabs > 0 then
        local singleTabWidthScale = 1 / numTabs
        for _, tInfo in ipairs(tabButtons) do
            tInfo.Button.Size = UDim2.new(singleTabWidthScale, 0, 1, 0)
            tInfo.Button.Position = UDim2.new(singleTabWidthScale * (tInfo.Index - 1), 0, 0, 0)
        end
    end
end
AdjustTabSizes()

local function UpdateIndicator(btn)
    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local textWidth = btn.TextBounds and btn.TextBounds.X or 40
    local centerX = btn.AbsolutePosition.X - TabContainer.AbsolutePosition.X + btn.AbsoluteSize.X / 2
    TweenService:Create(TabIndicator, ti, {
        Size = UDim2.new(0, textWidth + 10, 0, 3),
        Position = UDim2.new(0, centerX - (textWidth + 10) / 2, 1, -3)
    }):Play()
end

local function SwitchTab(tabName)
    activeTabName = tabName
    for _, tInfo in ipairs(tabButtons) do
        local isActive = tInfo.Name == tabName
        local ti = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(tInfo.Button, ti, {TextColor3 = isActive and COLORS.tabActive or COLORS.tabInactive}):Play()
        tInfo.Button.Font = isActive and Enum.Font.GothamBold or Enum.Font.Gotham
        if tabContents[tInfo.Name] then
            tabContents[tInfo.Name].Visible = isActive
        end
        if isActive then UpdateIndicator(tInfo.Button) end
    end
end

