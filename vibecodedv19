-- Resize Logic
local resizingX = false
local resizingY = false
local dragStartPos = nil
local frameStartSize = nil

local function initiateResize(x, y)
    resizingX = x
    resizingY = y
    dragStartPos = UserInputService:GetMouseLocation()
    frameStartSize = MainFrame.Size
end

ResizeBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then initiateResize(true, true) end
end)
ResizeRight.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then initiateResize(true, false) end
end)
ResizeBottom.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then initiateResize(false, true) end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then resizingX = false resizingY = false end
end)

RunService.RenderStepped:Connect(function()
    if (resizingX or resizingY) and dragStartPos and frameStartSize then
        local mouseLoc = UserInputService:GetMouseLocation()
        local deltaX = mouseLoc.X - dragStartPos.X
        local deltaY = mouseLoc.Y - dragStartPos.Y
        local newWidth = frameStartSize.X.Offset
        local newHeight = frameStartSize.Y.Offset
        if resizingX then newWidth = math.max(300, frameStartSize.X.Offset + deltaX) end
        if resizingY then newHeight = math.max(200, frameStartSize.Y.Offset + deltaY) end
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
    end
end)

