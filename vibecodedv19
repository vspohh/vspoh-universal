local function CreateSlider(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 50)
    Frame.BackgroundColor3 = COLORS.row
    Frame.BorderSizePixel = 0
    Frame.Parent = parent
    local fc = Instance.new("UICorner") fc.CornerRadius = UDim.new(0, 8) fc.Parent = Frame
    AddHover(Frame)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 0, 22)
    Label.Position = UDim2.new(0, 12, 0, 4)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = COLORS.textPrimary
    Label.Text = string.format("%s: %.2f", text, default)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, -24, 0, 6)
    SliderBG.Position = UDim2.new(0, 12, 0, 32)
    SliderBG.BackgroundColor3 = COLORS.sliderBg
    SliderBG.Text = ""
    SliderBG.AutoButtonColor = false
    SliderBG.BorderSizePixel = 0
    SliderBG.Parent = Frame
    local sbc = Instance.new("UICorner") sbc.CornerRadius = UDim.new(1, 0) sbc.Parent = SliderBG

    local pct = (default - min) / (max - min)
    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new(pct, 0, 1, 0)
    SliderFill.BackgroundColor3 = COLORS.accent
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBG
    local sfc = Instance.new("UICorner") sfc.CornerRadius = UDim.new(1, 0) sfc.Parent = SliderFill

    -- Thumb
    local Thumb = Instance.new("Frame")
    Thumb.Size = UDim2.new(0, 14, 0, 14)
    Thumb.Position = UDim2.new(pct, -7, 0.5, -7)
    Thumb.BackgroundColor3 = COLORS.knob
    Thumb.BorderSizePixel = 0
    Thumb.ZIndex = 8
    Thumb.Parent = SliderBG
    local thc = Instance.new("UICorner") thc.CornerRadius = UDim.new(1, 0) thc.Parent = Thumb

    local dragging = false
    SliderBG.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = UserInputService:GetMouseLocation().X
            local bgPos = SliderBG.AbsolutePosition.X
            local bgSize = SliderBG.AbsoluteSize.X
            local percent = math.clamp((mousePos - bgPos) / bgSize, 0, 1)
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            Thumb.Position = UDim2.new(percent, -7, 0.5, -7)
            local value = min + ((max - min) * percent)
            Label.Text = string.format("%s: %.2f", text, value)
            callback(value)
        end
    end)
    return Frame
end

