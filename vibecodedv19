local ActiveColorPicker = nil

local function OpenColorPicker(initialColor, callback)
    if ActiveColorPicker then ActiveColorPicker:Destroy() end
    local PickerFrame = Instance.new("Frame")
    local mouseLoc = UserInputService:GetMouseLocation()
    PickerFrame.Size = UDim2.new(0, 200, 0, 130)
    PickerFrame.Position = UDim2.new(0, mouseLoc.X + 15, 0, mouseLoc.Y - 15)
    PickerFrame.BackgroundColor3 = COLORS.bg
    PickerFrame.BorderSizePixel = 0
    PickerFrame.ZIndex = 100
    PickerFrame.Parent = ScreenGui
    local pc = Instance.new("UICorner") pc.CornerRadius = UDim.new(0, 10) pc.Parent = PickerFrame
    local ps = Instance.new("UIStroke") ps.Color = COLORS.separator ps.Thickness = 1 ps.Parent = PickerFrame

    local currentColor = initialColor
    local colorDisplay = Instance.new("Frame")
    colorDisplay.Size = UDim2.new(1, -20, 0, 24)
    colorDisplay.Position = UDim2.new(0, 10, 0, 10)
    colorDisplay.BackgroundColor3 = currentColor
    colorDisplay.ZIndex = 101
    colorDisplay.Parent = PickerFrame
    local dc = Instance.new("UICorner") dc.CornerRadius = UDim.new(0, 6) dc.Parent = colorDisplay

    local function addSlider(yPos, colorIdx)
        local bg = Instance.new("TextButton")
        bg.Size = UDim2.new(1, -20, 0, 12)
        bg.Position = UDim2.new(0, 10, 0, yPos)
        bg.BackgroundColor3 = COLORS.sliderBg
        bg.Text = ""
        bg.ZIndex = 101
        bg.AutoButtonColor = false
        bg.Parent = PickerFrame
        local bgc = Instance.new("UICorner") bgc.CornerRadius = UDim.new(1, 0) bgc.Parent = bg

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = (colorIdx == 1 and Color3.fromRGB(255,80,80)) or (colorIdx == 2 and Color3.fromRGB(80,255,80)) or Color3.fromRGB(80,80,255)
        fill.ZIndex = 102
        fill.BorderSizePixel = 0
        fill.Parent = bg
        local fc = Instance.new("UICorner") fc.CornerRadius = UDim.new(1, 0) fc.Parent = fill

        local val = (colorIdx == 1 and currentColor.R) or (colorIdx == 2 and currentColor.G) or currentColor.B
        fill.Size = UDim2.new(val, 0, 1, 0)

        local dragging = false
        bg.MouseButton1Down:Connect(function() dragging = true end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        RunService.RenderStepped:Connect(function()
            if dragging then
                local mx = UserInputService:GetMouseLocation().X
                local pct = math.clamp((mx - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                local r = (colorIdx == 1 and pct) or currentColor.R
                local g = (colorIdx == 2 and pct) or currentColor.G
                local b = (colorIdx == 3 and pct) or currentColor.B
                currentColor = Color3.new(r, g, b)
                colorDisplay.BackgroundColor3 = currentColor
                callback(currentColor)
            end
        end)
    end

    addSlider(44, 1)
    addSlider(66, 2)
    addSlider(88, 3)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(1, 0, 1, 0)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = ""
    closeBtn.ZIndex = 1
    closeBtn.Parent = ScreenGui
    closeBtn.MouseButton1Click:Connect(function()
        PickerFrame:Destroy()
        closeBtn:Destroy()
        ActiveColorPicker = nil
    end)
    ActiveColorPicker = PickerFrame
end

